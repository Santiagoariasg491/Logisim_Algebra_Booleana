  <!-- ===================================================================== -->
  <!-- CIRCUITO 3: SIMPLIFICACION QUINE-McCLUSKEY (Modulo 2)                 -->
  <!-- F = C | (A & B)                                                       -->
  <!-- ===================================================================== -->
  <circuit name="Simplificacion_Quine_McCluskey">
    <a name="circuit" val="Simplificacion_Quine_McCluskey"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>

    <comp lib="6" loc="(360,35)" name="Text">
      <a name="text" val="DEMO MODULO 2: SIMPLIFICACION CON QUINE-McCLUSKEY"/>
      <a name="font" val="SansSerif bold 14"/>
    </comp>
    <comp lib="6" loc="(360,58)" name="Text">
      <a name="text" val="Expresion original (19 compuertas) reducida a F = C | (A &amp; B) (solo 2 compuertas)"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>

    <comp lib="0" loc="(120,120)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="A"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>
    <comp lib="0" loc="(120,180)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="B"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>
    <comp lib="0" loc="(120,240)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="C"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>

    <comp lib="1" loc="(260,150)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(390,200)" name="OR Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="2"/>
    </comp>

    <comp lib="0" loc="(480,200)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="F = C | (A &amp; B)"/>
      <a name="labelloc" val="east"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>
    <comp lib="5" loc="(480,150)" name="LED">
      <a name="label" val="Salida F"/>
      <a name="labelloc" val="east"/>
    </comp>

    <wire from="(120,120)" to="(180,120)"/>
    <wire from="(180,120)" to="(180,130)"/>
    <wire from="(180,130)" to="(210,130)"/>

    <wire from="(120,180)" to="(180,180)"/>
    <wire from="(180,170)" to="(180,180)"/>
    <wire from="(180,170)" to="(210,170)"/>

    <wire from="(260,150)" to="(310,150)"/>
    <wire from="(310,150)" to="(310,180)"/>
    <wire from="(310,180)" to="(340,180)"/>

    <wire from="(120,240)" to="(310,240)"/>
    <wire from="(310,220)" to="(310,240)"/>
    <wire from="(310,220)" to="(340,220)"/>

    <wire from="(390,200)" to="(440,200)"/>
    <wire from="(440,200)" to="(480,200)"/>
    <wire from="(440,150)" to="(440,200)"/>
    <wire from="(440,150)" to="(480,150)"/>
  </circuit>

  <!-- ===================================================================== -->
  <!-- CIRCUITO 4: LEY DE DE MORGAN Y EQUIVALENCIA (Modulos 3 y 4)           -->
  <!-- ~(A & B)  ==  ~A | ~B                                                 -->
  <!-- ===================================================================== -->
  <circuit name="Equivalencia_De_Morgan">
    <a name="circuit" val="Equivalencia_De_Morgan"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>

    <comp lib="6" loc="(340,35)" name="Text">
      <a name="text" val="DEMO MODULOS 3 Y 4: LEY DE DE MORGAN ~(A &amp; B) == ~A | ~B"/>
      <a name="font" val="SansSerif bold 14"/>
    </comp>

    <comp lib="0" loc="(120,120)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="A"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>
    <comp lib="0" loc="(120,240)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="B"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>

    <!-- Rama 1: ~(A & B) -->
    <comp lib="1" loc="(250,140)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(320,140)" name="NOT Gate"/>
    <comp lib="0" loc="(450,140)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="~(A &amp; B)"/>
      <a name="labelloc" val="east"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>

    <!-- Rama 2: ~A | ~B -->
    <comp lib="1" loc="(230,220)" name="NOT Gate"/>
    <comp lib="1" loc="(230,280)" name="NOT Gate"/>
    <comp lib="1" loc="(340,250)" name="OR Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="0" loc="(450,250)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="~A | ~B"/>
      <a name="labelloc" val="east"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>

    <!-- Cableado -->
    <wire from="(120,120)" to="(160,120)"/>
    <wire from="(160,120)" to="(200,120)"/>
    <wire from="(160,120)" to="(160,220)"/>
    <wire from="(160,220)" to="(200,220)"/>

    <wire from="(120,240)" to="(140,240)"/>
    <wire from="(140,160)" to="(140,240)"/>
    <wire from="(140,160)" to="(200,160)"/>
    <wire from="(140,240)" to="(140,280)"/>
    <wire from="(140,280)" to="(200,280)"/>

    <wire from="(250,140)" to="(290,140)"/>
    <wire from="(320,140)" to="(450,140)"/>

    <wire from="(230,220)" to="(260,220)"/>
    <wire from="(260,220)" to="(260,230)"/>
    <wire from="(260,230)" to="(290,230)"/>

    <wire from="(230,280)" to="(260,280)"/>
    <wire from="(260,270)" to="(260,280)"/>
    <wire from="(260,270)" to="(290,270)"/>

    <wire from="(340,250)" to="(450,250)"/>
  </circuit>
</project>
