  <!-- ===================================================================== -->
  <!-- CIRCUITO 2: SUMADOR COMPLETO DE 1 BIT (Diapositiva 4 y Modulo 5)      -->
  <!-- ===================================================================== -->
  <circuit name="Sumador_Completo_1Bit">
    <a name="circuit" val="Sumador_Completo_1Bit"/>
    <a name="clabel" val="FA 1-bit"/>
    <a name="clabelup" val="north"/>
    <a name="clabelfont" val="SansSerif bold 11"/>

    <comp lib="6" loc="(310,35)" name="Text">
      <a name="text" val="SUMADOR COMPLETO DE 1 BIT (Diapositiva 4)"/>
      <a name="font" val="SansSerif bold 14"/>
    </comp>
    <comp lib="6" loc="(310,56)" name="Text">
      <a name="text" val="S = A XOR B XOR Cin   |   Cout = (A AND B) OR (Cin AND (A XOR B))"/>
      <a name="font" val="SansSerif plain 12"/>
    </comp>

    <comp lib="0" loc="(100,110)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="A"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>
    <comp lib="0" loc="(100,170)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="B"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>
    <comp lib="0" loc="(100,250)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="Cin"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>

    <comp lib="1" loc="(230,130)" name="XOR Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(370,150)" name="XOR Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(370,230)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(370,310)" name="AND Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(480,270)" name="OR Gate">
      <a name="size" val="50"/>
      <a name="inputs" val="2"/>
    </comp>

    <comp lib="0" loc="(540,150)" name="Pin">
